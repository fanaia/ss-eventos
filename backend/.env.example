# Identidade
SERVICE_NAME=ss-eventos
SERVICE_VERSION=0.1.0
PORT=4000
NODE_ENV=development

# Banco
MONGO_URI=mongodb://localhost:27017/ss-eventos

# Autenticacao e autorizacao pela Central de Ativacoes
CENTRAL_ATIVACAO_URL=https://central-ativacao.central.oondemand.online
CENTRAL_ATIVACAO_API_URL=https://central-ativacao.central.oondemand.online/api/
APP_CODE=ss-eventos
AUTH_PROVIDER_TIMEOUT_MS=10000
# Compatibilidade temporaria: CENTRAL_ATIVACAO_BACKEND_URL, MEUS_APPS_BACKEND_URL e APP_KEY tambem sao aceitas.

# Token de desenvolvimento local quando a Central sobrescrever verifyToken.
DEV_TOKEN=dev-local

# Integracao Omie - desligada ate a homologacao
OMIE_ENABLED=false
OMIE_WORKER_ENABLED=true
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_WEBHOOK_TOKEN=
OMIE_CONFIG_NAME=Omie SS Eventos
OMIE_ENVIRONMENT=producao
OMIE_CONTA_CORRENTE_ID=
OMIE_EXIGIR_NF=false
OMIE_TIMEOUT_MS=30000
OMIE_HTTP_ATTEMPTS=3
OMIE_WORKER_INTERVAL_MS=60000
OMIE_WORKER_BATCH_SIZE=20
OMIE_WEBHOOK_BATCH_SIZE=20
OMIE_WEBHOOK_MAX_BYTES=1048576
OMIE_MASTER_SYNC_INTERVAL_MS=21600000
OMIE_RECONCILE_INTERVAL_MS=3600000
